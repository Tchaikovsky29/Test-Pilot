# Copy to .env (keep .env in .gitignore) and fill in.

# Remote browser (CDP endpoint). Leave empty to launch Chromium locally.
TEST_PILOT_CDP_URL=

# --- LLM -----------------------------------------------------------------------------------------------
# Which provider to use: gemini (default), groq, openai or openrouter. Change this one line to switch.
LLM_PROVIDER=gemini

# Fill in the key for the provider you use. Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional. Defaults: gemini-3.8-flash | openai/gpt-oss-120b | gpt-6-luna | nvidia/nemotron-3.5-super-vl:free
LLM_MODEL= gemini-4-argon

# Optional tuning
# LLM_MAX_TOKENS=4096          # reasoning models think before answering, so keep this generous
# LLM_REASONING_EFFORT=low     # low | medium | high: lower is cheaper and faster
# LLM_TEMPERATURE=0.2          # ignored for openai (its reasoning models reject it)
# LLM_MAX_CALLS=60             # stop after this many model calls in one run
# LLM_BASE_URL=                # any other OpenAI-compatible endpoint, for example a local Ollama server